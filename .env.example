# Local defaults; set MOCK_MODE=false and provide keys for real LLM runs
MOCK_MODE=true
DATABASE_URL=postgresql://arp:arp@localhost:55432/arp
REDIS_URL=redis://localhost:56379
CONTROL_PLANE_URL=http://localhost:3801
PORT=3801
NEXT_PUBLIC_API_BASE=http://localhost:3801
FIXTURE_REPO_PATH=../agent-fixture-repo
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
JUDGE_LLM_MODEL=
JUDGE_LLM_API_KEY=
JUDGE_LLM_BASE_URL=
SANDBOX_IMAGE=arp-sandbox:latest
SANDBOX_CPUS=2
SANDBOX_MEMORY=2g
SANDBOX_TIMEOUT_S=900
SANDBOX_NETWORK_MODE=none
WORKER_ID=worker-1
HEARTBEAT_MS=10000

# Local single-user API; open Settings and use ~/.arp/access-token to sign in.
ARP_BIND_HOST=127.0.0.1
ARP_WEB_ORIGIN=http://localhost:3000
# Optional shared state path for API and Worker (default: ~/.arp)
# ARP_DATA_DIR=/absolute/path/to/private/arp-state
# REAL tasks require a verified provider-enforced input/context bound.
# 0 deliberately disables strict-budget model calls until configured.
LLM_CONTEXT_TOKEN_LIMIT=0
LLM_MAX_OUTPUT_TOKENS=4096
